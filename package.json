        "firebase-auth": "^0.1.2",
        "helmet": "^8.1.0",
        "joi": "^18.0.1",
        "nodemailer": "^7.0.10",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
